; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ascent"
config/description="A six-degrees-of-freedom mine shooter. Fly the tunnels, kill the rogue machines, blow the core, get out."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.004, 0.004, 0.012, 1)
boot_splash/image="res://assets/textures/splash.png"
boot_splash/stretch_mode=1

[autoload]

Mats="*res://scripts/mats.gd"
Settings="*res://scripts/settings.gd"
Sfx="*res://scripts/sfx.gd"
Music="*res://scripts/music.gd"
Game="*res://scripts/game.gd"
Saves="*res://scripts/saves.gd"
Progress="*res://scripts/progress.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="pickup"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
environment/ssao/quality=1
occlusion_culling/use_occlusion_culling=true
occlusion_culling/use_occlusion_culling.web=false
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
